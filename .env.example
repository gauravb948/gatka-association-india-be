DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gatka"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# National federation hostname for GET /domains/public/by-domain-name
NATIONAL_DOMAIN="gatkafederationindia.com"

# Cloudflare R2 (S3-compatible) for image uploads
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-bucket-name"
R2_PUBLIC_BASE_URL="https://<your-public-domain-or-r2-public-url>"
R2_REGION="auto"

# Rate limiting (per IP). Keep TRUST_PROXY=1 when behind Next.js, nginx, or Cloudflare
# (they send X-Forwarded-For). Set to 0 only for direct local access with no proxy.
TRUST_PROXY="1"
RATE_LIMIT_API_WINDOW_MS="900000"
RATE_LIMIT_API_MAX="30000"
RATE_LIMIT_AUTH_WINDOW_MS="900000"
RATE_LIMIT_AUTH_MAX="3000"
RATE_LIMIT_UPLOAD_WINDOW_MS="3600000"
RATE_LIMIT_UPLOAD_MAX="6000"

# SMS provider (Hypecreationz)
MSG_API_KEY=""
MSG_SENDER_ID=""
MSG_RESPONSE_FORMAT="JSON"
MSG_DLT_TEMPLATE_REGISTRATION_ID=""
MSG_DLT_TEMPLATE_PASSWORD_RESET_ID=""
